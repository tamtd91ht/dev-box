# VHS DevBox — env flags. Copy this file to `.env.local` (gitignored) and turn
# on the tabs you need. EVERY tool is OFF by default: a deployed/k8s build that
# sets nothing exposes nothing. All tools are LOCAL DEV ONLY — they open real
# sockets to real infrastructure from the machine hosting this server.

# ── Git workspace (SourceTree-style) — LOCAL DEV ONLY ─────────────────────────
# Enables the "Git" tab: pull / checkout / stage / commit / push over local
# repos, plus the Review MR runner (runs `git` + `claude` on this machine).
#   GIT_TOOL_ENABLED=true
# Root under which sibling repos are auto-detected (default: parent folder).
# Per-machine project list is configurable in the UI (.gitprojects.json).
#   GIT_TOOL_ROOT=D:/works/sources

# ── Folder picker (📂 Browse) ─────────────────────────────────────────────────
# Serves the folder picker used when adding a Git project or an integration pack
# (/api/fs-browse). Returns DIRECTORY LISTINGS ONLY, never file contents, and is
# ON by default because a browser cannot hand the server an absolute path. Set to
# 0 to switch folder listing off entirely (then paths must be typed).
#   FS_BROWSE_ENABLED=0
# Start folder of the picker = GIT_TOOL_BASE || GIT_TOOL_ROOT || parent of repo.

# ── Redis manager (RedisInsight-style) ────────────────────────────────────────
# Browse keys with SCAN (never KEYS), view value/type/TTL, bounded TTL edits,
# single-key delete with typed-confirm, INFO monitor per node (30s khi mở).
#   REDIS_TOOL_ENABLED=true
#   REDIS_CONNECTIONS_PATH=.redisconnections.json

# ── Kafka manager (perf-first) ────────────────────────────────────────────────
# Topics / consumer groups + lag / peek / time-window search / produce; cluster
# health (brokers, under-replicated, offline) + host metrics qua node_exporter
# (khai báo Metrics URLs trên connection). Read-only + produce; NO topic create/delete.
#   KAFKA_TOOL_ENABLED=true
#   KAFKA_CONNECTIONS_PATH=.kafkaconnections.json

# ── RabbitMQ manager ──────────────────────────────────────────────────────────
# HTTP management API: cluster/node health (RAM watermark · disk · fd · alarms),
# queues/exchanges/bindings + routing tester, peek (requeue-safe), publish.
#   RABBIT_TOOL_ENABLED=true
#   RABBIT_CONNECTIONS_PATH=.rabbitconnections.json
# Write ops (create/bind/purge/delete) — 3 gates: env flag + per-broker readOnly
# (defaults ON) + typed-confirm. Audit-logged (RABBIT_AUDIT).
#   RABBIT_ALLOW_DESTRUCTIVE=false

# ── MongoDB manager (Robo3T-lite) ─────────────────────────────────────────────
# Standalone / replica set / mongodb+srv (driver v5 — server 3.6→7.0). Tree
# db→collection, find/count/aggregate (read bounded maxTimeMS), indexes, stats,
# monitor (RAM/disk/connections/cache/ops + repl lag, 30s), quick-find preset,
# xuất báo cáo .xlsx.
#   MONGO_TOOL_ENABLED=true
#   MONGO_CONNECTIONS_PATH=.mongoconnections.json
# The ONE write — update-with-query — 3 gates: env flag + per-connection
# readOnly (defaults ON) + typed-confirm với dry-run count. Server luôn từ chối
# filter rỗng / replace cả document / upsert / insert / delete / drop.
# Audit-logged (MONGO_AUDIT).
#   MONGO_ALLOW_WRITE=false

# ── Elasticsearch manager — READ-ONLY ─────────────────────────────────────────
# Cluster node list (failover), ES 6.8 → 8.x, health + node monitor
# (heap/disk/cpu/load, 10s), indices, query DSL, mapping, quick-find preset,
# xuất .xlsx. Không tồn tại code path ghi.
#   ES_TOOL_ENABLED=true
#   ES_CONNECTIONS_PATH=.esconnections.json

# ── PostgreSQL manager ────────────────────────────────────────────────────────
# Tree database→table, SQL editor — mọi query đọc chạy trong transaction READ
# ONLY + statement_timeout 15s, trần 500 dòng; columns/indexes; quick-find
# preset (WHERE parameterized); xuất .xlsx.
#   PG_TOOL_ENABLED=true
#   PG_CONNECTIONS_PATH=.pgconnections.json
# The ONE write — UPDATE-with-WHERE — 3 gates: env flag + per-connection
# readOnly (defaults ON) + typed-confirm với dry-run count. WHERE rỗng / ";" /
# insert / delete / DDL: không tồn tại. Audit-logged (PG_AUDIT).
#   PG_ALLOW_WRITE=false

# ── Office editor (Excel/CSV + Word) — LOCAL DEV ONLY ─────────────────────────
# Tab "Office", 2 phân vùng: ▦ Bảng tính (.xlsx/.csv — xem dạng lưới, sửa ô,
# thêm/xóa dòng) và 🗎 Văn bản (.docx — xem theo đoạn văn, sửa nội dung đoạn,
# thêm/xóa đoạn; bảng chỉ xem, đoạn chứa ảnh/link/field bị khóa sửa). KHÔNG sửa
# cấu trúc cột/sheet. Trần 20 MB; hiển thị tối đa 5.000 dòng × 256 cột mỗi
# sheet / 5.000 đoạn (file lớn hơn vẫn sửa an toàn trong vùng hiện).
#   OFFICE_TOOL_ENABLED=true
# Ghi đè file (Lưu) — 2 gates: env flag + modal xác nhận. Luôn sao lưu
# `<file>.bak` cạnh file gốc rồi mới ghi (ghi file tạm + rename atomic; save bị
# từ chối nếu file đã đổi từ khi mở). Excel lưu bằng ExcelJS: ô không sửa giữ
# nguyên style/công thức, chart/pivot/macro có thể mất (.xlsm bị từ chối);
# Word sửa thẳng word/document.xml: đoạn không sửa giữ nguyên 100% (.doc/.docm
# bị từ chối). Audit-logged (SHEET_AUDIT / WORD_AUDIT).
# (Tên cũ SHEET_TOOL_ENABLED / SHEET_ALLOW_WRITE vẫn được chấp nhận.)
#   OFFICE_ALLOW_WRITE=false

# ── Google tab (Drive · Docs · Sheets) — READ-ONLY, MULTI-ACCOUNT ─────────────
# Quản lý tài liệu Google theo dự án, NHIỀU tài khoản song song (chip chuyển
# tài khoản trên toolbar, "＋ Tài khoản" đăng nhập thêm): đăng ký link thư mục
# Drive gốc per-tài-khoản (.googleroots.json, per-máy), duyệt cây thư mục con,
# danh sách toàn bộ Google Docs / Google Sheets (My Drive + Shared Drives, mới
# sửa trước, tìm theo tên, lọc ⭐). Mở file = nhảy sang Google trong browser —
# scope drive.readonly, server chỉ gọi files.list/files.get, KHÔNG tồn tại
# code path ghi lên Drive.
#   GOOGLE_TOOL_ENABLED=true
# OAuth client (một lần / máy, dùng chung cho mọi tài khoản):
# console.cloud.google.com/apis/credentials → OAuth client ID (Web
# application), redirect URI http://localhost:3000/api/google/callback, bật
# Google Drive API. Token lưu per-máy tại .googleauth.json (gitignored, dạng
# { accounts: [...] }); Đăng xuất từng tài khoản = revoke + gỡ khỏi danh sách.
#   GOOGLE_CLIENT_ID=
#   GOOGLE_CLIENT_SECRET=
# Đổi redirect khi chạy port khác:
#   GOOGLE_OAUTH_REDIRECT=http://localhost:3000/api/google/callback

# ── Webhooks tab (tool-service integration) ──────────────────────────────────
# Không cần env — cấu hình base URL + X-KEY/X-VALUE ngay trong UI (lưu per-máy
# qua .apitester-config.json).

# ── Telegram MR-review bot (npm run bot) — LOCAL DEV ONLY ────────────────────
# A SEPARATE long-running process (not part of the Next.js app, no listening
# port): long-polls a Telegram group for `/review <service> <branch> <mô tả>` and
# runs the read-only `/review-mr-dev` engine via the local `claude` CLI.
# Details: bot/README.md.
#
# REQUIRED (bot refuses to boot without them):
#   TELEGRAM_BOT_TOKEN=123456:ABC...
#   TELEGRAM_ALLOWED_CHAT_ID=-1001234567890
#
# DÙNG CHUNG: hành động "✈️ Gửi Telegram" của tab 🤖 Automation lấy MẶC ĐỊNH hai
# biến này (và BOT_OWNER_CHAT_ID) — token đọc lúc gửi, không chép vào
# .automation.json. Đặt ở đây là một chỗ duy nhất để xoay token cho cả hai.
#
# WHICH WORKSPACE does it review? Zero config if the project is already
# registered in the UI — the bot reads the SAME per-machine registries:
#   .apiintegrations.json (＋ Projects)  ·  .gitprojects.json (Git tab)
# Resolution order: BOT_BASE_PATH → BOT_PROJECT → the single registered pack →
# the single registered git project → parent folder of this repo. Several
# candidates and no BOT_PROJECT → boot fails instead of guessing.
#   BOT_PROJECT=MYPROJECT
#   BOT_BASE_PATH=D:/works/sources/myproject
# Repo-folder prefix that marks a reviewable service in that workspace. Empty by
# default (folder name used as-is); set it if your repos share a prefix, e.g.
# with `cloud-saas-` the folder cloud-saas-ai-service maps to service ai-service:
#   REVIEW_SERVICE_PREFIX=cloud-saas-
#
# Optional:
#   BOT_POLL_TIMEOUT_SEC=30          # getUpdates long-poll, 1..60
#   BOT_INSTANCE_ID=company          # label in logs + `npm run bot:status`
#   BOT_OWNER_CHAT_ID=123456789      # DM you on review START/DONE; unset = off

# ── Đồng bộ config (nút "Sync" ở footer) — CHỈ CHỦ REPO CONFIG ───────────────
# Đóng gói configs/ của máy, mã hoá bằng age, đẩy lên repo `dev-box-config`.
#
# TẮT MẶC ĐỊNH và bạn gần như chắc chắn KHÔNG cần bật: vault là một repo
# PRIVATE của riêng chủ sở hữu dev-box. Không có quyền clone repo đó (và không
# có passphrase) thì bật lên cũng không sync được gì — nút chỉ hiện ra rồi báo
# lỗi. Tắt là để tính năng không xuất hiện với người không dùng được nó.
#
# Muốn dùng cơ chế này cho RIÊNG BẠN: tự tạo một repo private của mình, chạy
# `scripts/bootstrap.ps1 -Init` trong đó để sinh khoá, rồi trỏ hai biến dưới
# vào repo ấy.
#   CONFIG_SYNC_ENABLED=true
#   DEVBOX_CONFIG_REPO_URL=https://github.com/<ban>/<repo-config>.git
#   DEVBOX_CONFIG_REPO=C:/Users/<ban>/.dev-box-config

# ── Zalo OA mini chat (optional embed) ────────────────────────────────────────
# Floating OA chat bubble. Renders NOTHING unless the OA id is set.
#   NEXT_PUBLIC_ZALO_OA_ID=

# ── Zalo API (THỬ NGHIỆM — tab "🧪 Zalo API") ─────────────────────────────────
# Nhánh thử tái sử dụng API nội bộ của Zalo Web (port từ zca-js): quét QR → lấy
# cookie/imei → login server-side → nhận (WebSocket) + gửi tin.
#
# ⚠ VI PHẠM điều khoản Zalo và CÓ THỂ LÀM KHOÁ TÀI KHOẢN. Chỉ chạy LOCAL và CHỈ
# với TÀI KHOẢN THỬ, không phải tài khoản thật của nhân viên.
#
# TẮT mặc định — phải bật tay thì route /api/zaloapi mới nhận request:
#   ZALOAPI_TOOL_ENABLED=true        # bật nhánh (login + nhận tin)
#   ZALOAPI_ALLOW_SEND=true          # cho phép GỬI thật (tách riêng, bật sau)

# ── Tab Terminal (shell thật trong app) ──────────────────────────────────────
# Mở PowerShell/cmd/Git Bash ngay trong DevBox: chạy trong tab, hoặc ở CỬA SỔ
# RỜI (đóng cửa sổ / app crash vẫn giữ nguyên phiên — shell là con của tiến
# trình Next server chứ không phải của cửa sổ).
#
# ⚠ Đây là shell access TUỲ Ý trên máy chạy server — chỉ dùng LOCAL, đừng bao
# giờ bật trên máy expose ra ngoài.
#
# Để trống thì kế thừa CODE_TOOL_ENABLED (máy đã bật Code Studio có sẵn terminal):
#   TERMINAL_ENABLED=true

# ── Tự cập nhật DevBox (nút ⬇ ở footer + hỏi lúc mở app) ─────────────────────
# App tự kéo bản mới của CHÍNH nó bằng `git pull --ff-only` trên thư mục cài đặt
# (chỉ chạy được khi app cài bằng `git clone`).
#
# Mở app lên là kiểm tra Git một lần: có bản mới thì HỎI "cập nhật không?" —
# chọn có thì pull rồi tự tải lại / mở lại app, chọn "Để sau" thì chạy bình
# thường. Đã mới nhất thì không hiện gì.
#
# LUÔN HỎI, KHÔNG BAO GIỜ TỰ CẬP NHẬT. Kéo code mới rồi khởi động lại là thay thứ
# đang chạy dưới chân người dùng, nên chỉ đi khi họ bấm đồng ý. Không có biến nào
# bật "tự pull" — cố tình không có.
#
# BẬT MẶC ĐỊNH: còn bản mới là còn hỏi, mỗi lần mở app. Đặt =false thì vào app
# không hỏi gì nữa (mạng chậm/VPN, hoặc chỉ muốn tự bấm khi cần):
#   SELF_UPDATE_PROMPT=false
#
# Nút ⬇ ở footer luôn dùng được, không phụ thuộc biến trên.

# ── Extension cho tab Browser ────────────────────────────────────────────────
# KHÔNG có biến môi trường nào ở đây — extension bật/tắt trong app:
#   tab Browser → menu ⋯ → 🧩 Extension
#
# Danh sách lưu ở data/browser/extensions/extensions.json (gitignored, riêng
# từng máy). CHỈ áp cho tab Browser; Workspace (Zalo/Telegram), Links, Google
# và Zalo API không nạp extension — các tab đó đang đăng nhập thật, một content
# script hỏng là hỏng phiên làm việc.
#
# Electron chỉ chạy CONTENT SCRIPT (chèn JS/CSS vào trang) + chrome.storage /
# chrome.runtime. KHÔNG có chrome.tabs, chrome.webRequest, hay nút trên thanh
# công cụ — nên phần lớn extension tải từ Chrome Web Store (uBlock Origin,
# trình quản lý mật khẩu…) sẽ không chạy đúng. Panel đọc manifest.json và cảnh
# báo trước từng cái.
#
# Chỉ nhận THƯ MỤC đã giải nén có manifest.json, không nhận file .crx.
# Extension mẫu: electron/extensions-sample/hello-devbox
